{
  "name": "u",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "check": "tsc --noEmit",
    "dev:desktop": "tauri dev",
    "build:dmg": "tauri build --bundles app,dmg && node scripts/verify-macos-bundle.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "build:web": "tsc --noEmit && vite build",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/duckfollow/u.git"
  },
  "homepage": "https://github.com/duckfollow/u#readme",
  "bugs": {
    "url": "https://github.com/duckfollow/u/issues"
  },
  "description": "A local API workbench and workflow studio",
  "author": "duckfollow"
}
